[Unit]
Description=AI Operations MCP Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=test
Group=test
WorkingDirectory=/opt/aiops/vm2
Environment=HOME=/nonexistent
Environment=AIOPS_SSH_KEY=/etc/aiops/aiops_vm1_ed25519
Environment=AIOPS_KNOWN_HOSTS=/etc/aiops/known_hosts
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/aiops/venv/bin/python /opt/aiops/vm2/aiops_mcp_server.py --http
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
