#!/usr/bin/env bash
# Produces a bounded, read-only diagnostic snapshot for the AI operations VM.
set -Eeuo pipefail

if [[ "$#" -ne 0 ]]; then
  echo "This command does not accept arguments." >&2
  exit 64
fi

redact() {
  sed -E 's/((password|token|secret|authorization)[[:space:]]*[:=][[:space:]]*)[^[:space:]]+/\1[REDACTED]/Ig'
}

section() {
  printf '\n===== %s =====\n' "$1"
}

section "SNAPSHOT METADATA"
printf 'timestamp_utc=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
printf 'hostname=%s\n' "$(hostname)"

section "HOST RESOURCES"
uptime
free -h
df -h /

section "SERVICE STATUS"
printf 'jenkins='
systemctl is-active jenkins || true
printf 'docker='
systemctl is-active docker || true

section "CONTAINERS"
docker ps --format 'table {{.Names}}\t{{.Image}}\t{{.Status}}\t{{.Ports}}' | redact

section "APPLICATION LOGS (LAST 150 LINES)"
if docker ps -a --format '{{.Names}}' | grep -Fxq 'system-monitor-api'; then
  docker logs --tail 150 system-monitor-api 2>&1 | redact
else
  echo 'system-monitor-api container not found'
fi

section "JENKINS LOGS (LAST 150 LINES)"
journalctl --no-pager -u jenkins -n 150 2>&1 | redact
